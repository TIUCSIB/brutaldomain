# GitHub OAuth (required for console login)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=

# Optional: only these GitHub usernames can enter the console
# Example: biscuit,another-user
GITHUB_ALLOWED_USERS=

# DNSHE API (required for real domain/DNS data)
DNSHE_API_BASE_URL=https://api005.dnshe.com/index.php
DNSHE_API_KEY=
DNSHE_API_SECRET=

# Expiry notify secrets only (optional). Delivery targets are saved in Settings UI.
# Email via Resend: https://resend.com
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=BrutalDomain <onboarding@resend.dev>
# Optional bootstrap defaults used only before first Settings save
NOTIFY_EMAIL=
# Telegram Bot token from @BotFather (never expose to client)
TELEGRAM_BOT_TOKEN=
# Optional bootstrap chat id used only before first Settings save
TELEGRAM_CHAT_ID=
# Protect /api/cron/expiry-notify (header x-cron-secret or ?secret=)
CRON_SECRET=
# Optional bootstrap window before first Settings save
NOTIFY_WINDOW_DAYS=30

# Durable server prefs store (recommended on Vercel Hobby/Pro)
# Dashboard → Storage → Create Blob Store → connect to this project
# Injects BLOB_READ_WRITE_TOKEN automatically. Local dev falls back to .data/
BLOB_READ_WRITE_TOKEN=
